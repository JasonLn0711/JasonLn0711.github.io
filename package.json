{
  "name": "research-portfolio",
  "description": "SvelteKit static personal website and MDX blog for Jason Chia-Sheng Lin, covering trustworthy AI, speech intelligence, cybersecurity, and regulated AI systems.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-tc": "5.3.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@types/node": "^25.9.1",
    "@types/unist": "2.0.11",
    "katex": "^0.18.7",
    "mdsvex": "^0.12.7",
    "remark-math": "^3.0.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.4.8",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "wrangler": "4.152.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.23.0"
}
